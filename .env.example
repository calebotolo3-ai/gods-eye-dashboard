# Copy to .env.local for local development. Never commit real credentials.
# Optional: enables server-side Gemini summaries only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: enables live sampled road traffic speeds through TomTom Traffic API.
# Keep this key server-side; never use a VITE_ prefix.
TOMTOM_API_KEY=
